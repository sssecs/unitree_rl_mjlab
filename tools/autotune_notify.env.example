# Copy to .autotune/notify.env and chmod 600. Never commit the real file.
AUTOTUNE_SMTP_HOST=smtp.example.com
AUTOTUNE_SMTP_PORT=465
AUTOTUNE_SMTP_SSL=true
AUTOTUNE_SMTP_USERNAME=robot@example.com
AUTOTUNE_SMTP_PASSWORD=use-an-app-specific-password
AUTOTUNE_EMAIL_FROM=robot@example.com
AUTOTUNE_EMAIL_TO=you@example.com
